generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hotel {
  id             String   @id @default(cuid())
  name           String
  googlePlaceId  String?  @unique @map("google_place_id")
  tripAdvisorId  String?  @unique @map("trip_advisor_id")
  tripAdvisorUrl String?  @map("trip_advisor_url")
  city           String?
  country        String?
  imageUrl       String?  @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")
  reviews        Review[]
  favourites     FavouriteHotel[]
  searchLogs     SearchLog[] @relation("SearchLogToHotel")

  @@map("hotels")
}

model Review {
  id         String    @id @default(cuid())
  hotelId    String    @map("hotel_id")
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  source     String    // "google" | "tripadvisor"
  externalId String?   @map("external_id")
  authorName String    @map("author_name")
  authorUrl  String?   @map("author_url")
  rating     Int?
  text       String
  reviewDate DateTime? @map("review_date")
  reviewLink String?   @map("review_link")
  language   String?
  fetchedAt  DateTime  @default(now()) @map("fetched_at")

  @@unique([hotelId, source, externalId])
  @@index([hotelId, source])
  @@map("reviews")
}

model SearchLog {
  id            String    @id @default(cuid())
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query         String
  
  hotels        Hotel[]   @relation("SearchLogToHotel")

  asOfDate      DateTime? @map("as_of_date")
  resultCount   Int       @map("result_count")
  lastMatchDate DateTime? @map("last_match_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([query])
  @@map("search_logs")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model Log {
  id        String   @id @default(cuid())
  level     String   // "INFO", "WARN", "ERROR"
  source    String   // "apify", "rapidapi", "cron", "system"
  message   String
  details   String?  // JSON payload or stack trace
  hotelId   String?  @map("hotel_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([level, source, createdAt])
  @@map("logs")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  provider        String    @default("local")    // "local" | "google" | "apple"
  providerId      String?   @map("provider_id")
  role            String    @default("user")     // "admin" | "user"
  status          String    @default("pending")  // "pending" | "active" | "rejected"
  emailVerified   Boolean   @default(false) @map("email_verified")
  verifyCode      String?   @map("verify_code")
  verifyCodeExp   DateTime? @map("verify_code_exp")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  stripeCustomerId       String?   @map("stripe_customer_id")
  stripeSubscriptionId   String?   @map("stripe_subscription_id")
  isSubscribed           Boolean   @default(false) @map("is_subscribed")

  favourites      FavouriteHotel[]
  hotelRequests   HotelRequest[]
  searchLogs      SearchLog[]

  @@map("users")
}

model FavouriteHotel {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  hotelId   String   @map("hotel_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, hotelId])
  @@map("favourite_hotels")
}

model HotelRequest {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  state     String?
  country   String?
  status    String   @default("pending")  // "pending" | "approved" | "rejected"
  adminNote String?  @map("admin_note")
  userNotified Boolean @default(false) @map("user_notified")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("hotel_requests")
}
